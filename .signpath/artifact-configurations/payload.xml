<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <zip-file path="payload-signing-v${version}.zip">
      <pe-file path="LanFileSharing.exe"
               product-name="LAN File Sharing"
               product-version="${version}"
               file-version="${version}.0.0"
               company-name="LAN File Sharing contributors"
               original-filename="LanFileSharing.exe">
        <authenticode-sign hash-algorithm="sha256" />
      </pe-file>
      <powershell-file-set>
        <include path="*.ps1" min-matches="1" max-matches="unbounded" />
        <include path="src/*.ps1" min-matches="1" max-matches="unbounded" />
        <for-each>
          <authenticode-sign hash-algorithm="sha256" />
        </for-each>
      </powershell-file-set>
    </zip-file>
  </zip-file>
</artifact-configuration>

